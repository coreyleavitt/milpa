        }
      }
    },
    {
      "method": "GET",
      "url": "https://ghcr.io/token?scope=repository%3Acoreyleavitt%2Ftest-pkg%3Apull&service=ghcr.io",
      "response": {
        "status": 503,
        "headers": {
          "Content-Length": "0"
        }
      }
