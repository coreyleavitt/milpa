// fixture-414: named dep resolved from a tianguis index whose sole provenance
// is OCI (registry/repository/digest), not git.  Companion to fixture-061
// (named-dep, git provenance) — proves the mocked-fetches/ OCI format
// (conformance-fixtures.md §2.3.5) and that both impls' resolvers materialize
// an OCI-provenance index entry end-to-end (resolve -> fetch -> lock).
name "myapp"
kind "application"
deps {
    bar ">= 1.0.0"
}
