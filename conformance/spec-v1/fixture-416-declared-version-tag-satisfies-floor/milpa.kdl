// fixture-416: Axis A (b) step 3 (A3) — a git dep's declared version, derived
// from its version-shaped git tag (no milpa.kdl/.nimble version present),
// satisfies another dep's named `>=` floor.
//
// bearssl is pinned to tag "v0.5.0"; its .nimble carries no `version` field
// (steps 1-2 both miss), so declared_version_for falls to step 3: parse the
// ref itself as a version.  0.5.0 satisfies chronos's `bearssl >= 0.2.8`
// floor (0.0.1, the pre-A3 sentinel, would not have).
//
// chronos itself declares no version in its .nimble and is pinned to branch
// "main" (not version-shaped) — it stays version-unknown (the existing
// 0.0.1 sentinel label), proving the version-unknown path is unaffected (no
// regression) in the very same fixture.
name "myapp"
kind "application"
deps {
    bearssl git=(url)"https://example.com/bearssl.git" ref="v0.5.0"
    chronos git=(url)"https://example.com/chronos.git" ref="main"
}
