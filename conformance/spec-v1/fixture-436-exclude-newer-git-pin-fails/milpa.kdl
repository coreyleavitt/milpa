// resolution-semantics RFC §3 Axis D, D6: the same single-candidate git
// pin as fixture-435, but the resolved commit's committer date is AFTER
// the bound -- unconditional RES-EXCLUDE-NEWER-PIN, no fallback (a git
// dep has exactly one candidate, unlike an index dep -- D-D1/D-D2).
name "myapp"
kind "application"
resolution {
    exclude-newer "2026-01-01T00:00:00Z"
}
deps {
    widget git=(url)"https://example.com/widget.git" ref="v1.0.0"
}
index-trust "warn"
