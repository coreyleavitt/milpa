// milpa manifest schema — v0
//
// This file documents the shape of a `milpa.kdl` manifest. It is
// authoritative *intent*; the canonical authority for what milpa
// accepts is the parser in `milpa/manifest.py`. Keeping the two in
// sync is enforced by writing tests against this schema's examples.
//
// Future work: actually parse this schema and use it as the source
// of truth for validation. Tracked at backlog issue #24.
//
// Note on the identity model: every dep in milpa.kdl declares
// *provenance* (where the bytes come from). milpa computes the
// *identity* (sha256 content hash) post-fetch and records it in
// milpa.lock. See docs/identity-and-provenance.md for the model.

// A milpa.kdl is one of two disjoint roles (virtual-workspace-only):
//
//   - PACKAGE manifest: declares `name`, `deps`, `kind`, optional
//     `overrides`. The standalone-project case OR a workspace member.
//   - WORKSPACE manifest: declares `workspace { member "<path>" }`,
//     optional `name`, optional `overrides`. Pure container — must
//     NOT carry `deps` or `kind`.
//
// Use `parse_workspace_or_manifest` to accept either kind; the
// returned value's type tells you which.

// `name` top-level node: required for any package manifest.
//   name "<x>"
//
// Intrinsic identity. Required for every package (anything with
// `deps` or `kind`). Optional for workspace-only manifests. Used by
// the resolver (workspace member-table routing), by the lockfile
// (self-describing), and in error messages.

// `workspace` block: declares members of a virtual workspace.
//   workspace {
//       member "<path>"   // zero-or-more
//   }
//
// A workspace manifest must NOT contain `deps` or `kind`. To make
// the workspace root also a package, declare `member "."` and place
// deps/kind in the root member's milpa.kdl. Member paths are
// preserved in declaration order; duplicates are rejected.

// `deps` block: zero-or-more dependencies. Four shapes per child:
//
// URL DEP — fetch the bytes from a git URL at a ref.
//   <name> git=(url)"<URL>" ref="<git-ref>"
//   Properties:
//     git: a git-clonable URL (https / http / ssh / git scheme)
//     ref: a git ref (branch / tag / commit SHA)
//   The `(url)` KDL type annotation on the git value is recommended
//   for self-documentation; both forms parse identically.
//
// NAMED DEP — resolve via the nim-lang/packages registry.
//   <name>                       // any version
//   <name> "<version-constraint>"  // pinned by constraint
//   No properties; zero or one positional string argument carrying
//   the version constraint (`>= 0.5.0`, `< 1.0.0`, `>= 0.5 & < 1.0`,
//   `== 0.5.0`, or omitted for any version).
//
// LOCAL DEP — copy a source tree from a filesystem path.
//   <name> local="<path>"
//   Properties:
//     local: a relative-to-project (or absolute) path to a directory
//   The tree is copied into _deps/<name> at fetch time (snapshot
//   semantics — symlink/live mode is deferred; see
//   docs/rfc-pluggable-fetchers.md). Identity is recorded at fetch
//   time; `milpa verify` warns when the source has drifted from the
//   snapshot (re-run `milpa fetch` to refresh).
//
// MEMBER DEP — reference a workspace-internal member by name.
//   member "<name>"
//   Reserved leading keyword `member` (NOT a package name), followed
//   by exactly one positional string (the member's intrinsic name).
//   No properties. Resolved through the workspace member table, NOT
//   through any fetcher — the bytes already live at the member's
//   declared location.
//
// Disambiguation: a child whose KDL node name is `member` is a
// member dep. Otherwise: with `git=` → URL dep; with `local=` → local
// dep; without either → named dep. Mixing `git=` and `local=` is
// rejected.
//
// Example (mixed):
//
//   name "fresco"  // intrinsic identity
//
//   deps {
//       // URL deps (provenance: explicit git URL + ref)
//       chronos git=(url)"https://github.com/coreyleavitt/chronos.git" ref="feat/contextvars"
//
//       // Named deps (provenance: nim-lang/packages registry)
//       results
//       stew ">= 0.5.0"
//
//       // Local dep (provenance: filesystem path)
//       sinopia local="../sinopia"
//
//       // Member dep (workspace-internal reference, this manifest is
//       // a workspace member)
//       member "intonaco"
//   }
//
// Identity model: every dep declares *provenance*. milpa computes the
// *identity* (sha256 content hash) post-fetch and records it in
// milpa.lock. See docs/identity-and-provenance.md for the model.
//
// Constraints:
//   - dep names are unique within a manifest (URL or named — same namespace)
//   - URL dep without `ref=` is an error
//   - named dep with any property (other than `git=`, which routes
//     to the URL path) is an error
//   - named dep with multiple positional arguments is an error
//
deps "0..*" {
    // URL form
    "<name>" git=(url)"<URL>" ref="<git-ref>"
    // Named form (no properties; optional positional constraint)
    "<name>" "<version-constraint>?"
    // Local form
    "<name>" local="<path>"
    // Workspace-internal member form (reserved keyword `member`)
    member "<member-name>"
}

// Workspace-root manifest example:
//
//   workspace {
//       member "fresco"
//       member "intonaco"
//       member "sinopia"
//   }
workspace "0..1" {
    member "<member-path>" "0..*"
}

// Intrinsic identity (required for every package manifest)
name "<name>"

// `kind` declares whether this is a library or an application.
//
// - "library":     the project is a library others depend on. Lockfile
//                  exists locally for fast iteration but should NOT be
//                  committed — downstream consumers re-resolve their own.
// - "application": the project is the final consumer. Lockfile is
//                  committed to ensure reproducible builds across machines.
//
// Default (if omitted): "library".
//
kind "library"  // or "application"

// `overrides` block (optional): zero-or-more rewrite rules. Each
// matches by dep NAME and substitutes the entire URL+ref. Applies
// project-wide — to manifest-direct deps, transitive URL deps, and
// named (registry) deps. Does not propagate to downstream consumers.
//
// v0.x supports only the `pkg` form. Atlas-style `url <from> <to>`
// and `name <old> <new>` are future extensions.
//
// Example:
//
//   overrides {
//       // Use a fork of chronos while upstream PR is in review
//       pkg "chronos" git=(url)"https://github.com/my-fork/chronos.git" ref="my-fix"
//
//       // Redirect a registry dep to an internal mirror
//       pkg "results" git=(url)"https://internal-mirror/results.git" ref="v0.5.1"
//   }
//
// Constraints:
//   - one override per name (duplicates rejected)
//   - both `git=` and `ref=` are required on every pkg override
//   - unknown properties or unknown override kinds (`url`, `name`)
//     rejected with a clear error
//
// Interaction with content-addressed identity: overrides change
// provenance only. Identity follows whatever the override's content
// hashes to. milpa.lock records the override's URL/ref/sha/
// content_hash — the actually-fetched provenance, not the
// aspirational one.
overrides "0..*" {
    pkg "<name>" git=(url)"<URL>" ref="<git-ref>"
}
